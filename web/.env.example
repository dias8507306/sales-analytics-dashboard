# Copy to .env and fill in. Never commit .env.
# Leave SHEET_API_URL / SHEET_API_KEY empty to run in DEMO mode (random data from api/sample-data.json).
# DEMO_MODE=0 disables the demo fallback.

# Google Sheet web app URL (sheet menu "WhatsApp → Link for the site"), ends with /exec
SHEET_API_URL=
# Key from the same dialog
SHEET_API_KEY=
# Dashboard password (empty = no password)
DASHBOARD_PASSWORD=
# AI key for the "Make report" button: sk-ant-… (Claude), sk-or-… (OpenRouter) or sk-… (OpenAI). Optional.
AI_API_KEY=
# Another AI model (optional)
AI_MODEL=
# Port and address. 127.0.0.1 if nginx sits in front of the server
PORT=3000
HOST=127.0.0.1
